{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paper-pipeline/program-committee/1.0",
  "title": "Program committee",
  "description": "The venue's full program committee. Produced by venue-intake; consumed by reviewer-match and pc-citation-scan.",
  "type": "object",
  "required": ["artifact", "schema_version", "generated_by", "venue_name", "members"],
  "additionalProperties": false,
  "properties": {
    "artifact": { "const": "program-committee" },
    "schema_version": { "const": "1.0" },
    "generated_by": { "type": "string", "minLength": 1 },
    "venue_name": { "type": "string", "minLength": 1 },
    "source_url": { "type": "string" },
    "complete": { "type": "boolean", "description": "False when the roster could not be fully harvested; downstream matching is then best-effort" },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "role"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "Stable slug, referenced by reviewer-matches and pc-citations" },
          "name": { "type": "string", "minLength": 1 },
          "role": { "enum": ["chair", "co-chair", "area-chair", "pc", "erc", "external"] },
          "affiliation": { "type": "string" },
          "country": { "type": "string" },
          "homepage": { "type": "string" },
          "dblp": { "type": "string" },
          "topics": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
